{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the dense carrier stays in the image flow.",
      "claim": "A persistent dense carrier, read and updated by a compact thought process.",
      "narration": "The image first becomes a dense carrier, so spatial detail has somewhere to live. Windowing keeps the carrier dense while giving the thought process local tokens to read. The DQ-CTM stage is the recurrent part; each tick comes back to the thought process itself. The same DQ-CTM parameters are reused across ticks instead of adding a new block each time. The decoder reads the updated carrier back into the super-resolution image.",
      "evidence": [
        {
          "kind": "section",
          "id": "sec2"
        },
        {
          "kind": "figure",
          "id": "fig-arch"
        }
      ],
