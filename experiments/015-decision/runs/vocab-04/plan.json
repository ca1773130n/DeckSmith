{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the dense carrier continues through the end-to-end flow.",
      "claim": "ThinkSR runs encoder, windows, shared DQ-CTM ticks, and decoder; parameters are shared across ticks.",
      "narration": "The image first becomes a dense carrier, so spatial detail is available before the compact thought process starts. Windowing partitions that carrier without turning the whole model into a global recurrent loop. The DQ-CTM stage repeats on itself, so the recurrence is local to the thought process. The same DQ-CTM parameters are reused across ticks rather than growing with the tick count. The close view isolates the repeated thought stage because that is where the recurrence lives.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
