    {
      "id": "s02-carrier",
      "intent": "The equation first makes a dense feature field from the low-resolution image, then partitions that field into window tokens.",
      "claim": "\\mathbf{F}=\\mathcal{E}(\\mathbf{I}_{\\mathrm{LR}}),\\qquad \\mathbf{X}=\\mathcal{W}(\\mathbf{F})",
      "narration": "The encoder maps the low-resolution image into the feature field called F. That field is the dense carrier the method keeps reading and updating. The window operator partitions F into X without changing the carrier’s role. The compact thought process works on these window tokens instead of replacing the dense field.",
      "evidence": [
        {
          "kind": "equation",
          "id": "eq-carrier"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
