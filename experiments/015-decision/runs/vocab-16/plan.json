{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to one thought stage, while the dense carrier continues through the full super-resolution flow.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes a dense feature field that keeps spatial detail available. Windowing changes the carrier into tokens without discarding the carrier. The compact DQ-CTM thought process reads and updates that carrier over repeated ticks. The loop is only inside the thought stage, so the whole flow is not rerun. The same DQ-CTM parameters are reused at each tick.",
      "evidence": [
