  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the compact thought stage, while the dense carrier moves through the full super-resolution flow.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes a dense carrier before it is partitioned into windows. The compact DQ-CTM process reads and updates those window tokens. The recurrence repeats inside the thought process, with shared parameters across ticks. The decoder turns the updated dense field back into the super-resolved image.",
