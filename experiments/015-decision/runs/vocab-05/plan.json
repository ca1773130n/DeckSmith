  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the compact thought stage, while the dense carrier continues through the full super-resolution flow.",
      "claim": "A persistent dense carrier, read and updated by a compact thought process.",
      "narration": "ThinkSR starts by encoding the low-resolution image into a dense carrier that can keep spatial detail. The carrier is partitioned into windows before the thought process reads and updates it. The recurrence is inside the DQ-CTM thought stage, with parameters shared across ticks. The decoder turns the updated dense field into the final super-resolved image.",
      "evidence": [
        {
          "kind": "section",
          "id": "sec2"
        },
        {
          "kind": "figure",
          "id": "fig-arch"
        }
      ],
