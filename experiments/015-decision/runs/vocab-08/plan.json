  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage itself, while the image still moves through one encoder-to-decoder flow.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The low-resolution image first becomes a feature field, then the field is split into windows without changing the carrier idea. The compact thought process repeats on the windowed carrier, so the loop belongs to DQ-CTM ticks rather than the whole pipeline. The same DQ-CTM parameters are reused across ticks before the decoder produces the output image.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
