    {
      "id": "s02-carrier",
      "intent": "The carrier equation says the low-resolution image becomes a dense feature field, then windows partition that field into tokens.",
      "claim": "\\mathbf{F}=\\mathcal{E}(\\mathbf{I}_{\\mathrm{LR}}),\\qquad \\mathbf{X}=\\mathcal{W}(\\mathbf{F})",
      "narration": "The encoder maps the low-resolution image into the dense carrier named F. The first equality is the carrier step, not the reconstruction step. The window operator then partitions that same field into X. The close view emphasizes that windowing keeps tokens from the dense carrier rather than replacing it.",
      "evidence": [
        {
          "kind": "equation",
          "id": "eq-carrier"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
