{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The method is a four-stage flow, and the recurrence returns only to the DQ-CTM thought stage while its tick parameters are shared.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image is first encoded into features before any recurrent thinking begins. The feature field is partitioned into windows, keeping the spatial carrier dense. The DQ-CTM thought process runs for repeated ticks inside the window stage. The loop returns to the thought stage itself, not to the whole pipeline. Those ticks share parameters, so repetition does not mean a new parameter set each time. The decoder turns the updated dense carrier back into the super-resolved image.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
