  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the encoder, windowing, and decoder remain a straight image-to-image path.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes features, then windows, before the compact thought process begins. The recurrence is local to the thought stage, so each tick updates that stage rather than rerunning the whole pipeline. The same DQ-CTM parameters are reused across ticks. The decoder turns the updated dense carrier back into the super-resolved image.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
