  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the compact thought stage, while the image carrier still moves through the full super-resolution flow.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The low-resolution image first becomes a dense carrier that can preserve spatial detail. The carrier is split into windows before the thought process reads it. The compact DQ-CTM stage ticks repeatedly on the window state. The loop returns only to the thought stage, not to the whole pipeline. The same DQ-CTM parameters are shared across those ticks. Decoding happens after the recurrent thought process has updated the dense carrier.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
