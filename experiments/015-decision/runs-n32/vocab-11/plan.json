{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "ThinkSR moves through four stages, and the recurrence returns only to the DQ-CTM thought stage while tick parameters are shared.",
      "claim": "A persistent dense carrier, read and updated by a compact thought process.",
      "narration": "The encoder starts by turning the low-resolution input into the dense carrier the rest of the method keeps. Windowing partitions that dense field before the thought process works on it. The recurrence is inside the DQ-CTM stage, so each tick returns to the thought process, not to the encoder. The ticks share parameters, then the decoder maps the updated carrier back to the output image.",
      "evidence": [
        {
          "kind": "section",
          "id": "sec2"
        },
        {
