    {
      "id": "s02-carrier",
      "intent": "The carrier equation first creates a dense feature field from the low-resolution image, then partitions that field into windows without dropping tokens.",
      "claim": "\\mathbf{F}=\\mathcal{E}(\\mathbf{I}_{\\mathrm{LR}}),\\qquad \\mathbf{X}=\\mathcal{W}(\\mathbf{F})",
      "narration": "The encoder takes the low-resolution image as its input. Its output is the dense feature field named F. The window operator acts on that same field. The result is X, the windowed token set. The partition changes the grouping, not the fact that every token is carried forward.",
      "evidence": [
        {
          "kind": "equation",
          "id": "eq-carrier"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
