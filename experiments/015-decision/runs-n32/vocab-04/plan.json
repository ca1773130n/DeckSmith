  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "ThinkSR runs image information forward through four stages, while the recurrence returns only to the DQ-CTM thought stage.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes a dense carrier before any compact thought process acts on it. The carrier is split into windows so the thought process can work locally. The recurrent ticks return to the DQ-CTM stage itself, not to the encoder or decoder. The same DQ-CTM parameters are reused across ticks. The decoder reads the updated dense carrier to produce the output.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
