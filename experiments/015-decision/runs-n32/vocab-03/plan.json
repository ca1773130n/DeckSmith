{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the full image path still moves encode, window, think, decode.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes a dense carrier, then it is split into windows without leaving the dense path. The compact thought process reads and updates those windows over repeated ticks. The loop returns only to the thought stage, so the encoder and decoder are not rerun each tick. The repeated ticks share parameters, which is why the loop is drawn inside the thought block.",
      "evidence": [
