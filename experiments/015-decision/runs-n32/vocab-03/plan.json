    {
      "id": "s02-carrier",
      "intent": "The carrier equation says the low-resolution image becomes a dense feature field, then windows are taken from that field while preserving the tokens.",
      "claim": "\\mathbf{F}=\\mathcal{E}(\\mathbf{I}_{\\mathrm{LR}}),\\qquad \\mathbf{X}=\\mathcal{W}(\\mathbf{F})",
      "narration": "The encoder acts on the low-resolution image and produces F, the dense feature field. The first term is the carrier: it is dense before the thought process starts. The window operator then partitions that same field into X. The partition keeps every token, so the carrier remains the spatial source for the thought process.",
      "evidence": [
        {
          "kind": "equation",
          "id": "eq-carrier"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
