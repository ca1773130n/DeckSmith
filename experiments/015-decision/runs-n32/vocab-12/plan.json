    {
      "id": "s02-carrier",
      "intent": "The carrier equation separates dense encoding from window partitioning that keeps the encoded tokens.",
      "claim": "\\mathbf{F}=\\mathcal{E}(\\mathbf{I}_{\\mathrm{LR}}),\\qquad \\mathbf{X}=\\mathcal{W}(\\mathbf{F})",
      "narration": "The encoder maps the low-resolution image into the dense feature field. The symbol F names the persistent carrier that the method keeps in dense form. The window operator partitions that carrier instead of discarding it. The resulting X is the token view passed to the thought process.",
      "evidence": [
        {
          "kind": "equation",
          "id": "eq-carrier"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
