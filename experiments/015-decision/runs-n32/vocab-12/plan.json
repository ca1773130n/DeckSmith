{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, not the whole image flow.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes a dense feature field before any recurrent thought is applied. Windowing changes the field into local token sets without restarting the whole pipeline. The DQ-CTM stage ticks repeatedly, and the loop returns only to that thought process. The same parameters are used across ticks, so recurrence adds depth without adding new tick-specific weights.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
