{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the dense carrier stays in the end-to-end image flow.",
      "claim": "ThinkSR is end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes a dense carrier, so spatial detail has somewhere to live. Windowing exposes local tokens without changing the carrier into a compact state. The DQ-CTM ticks recur inside the thought stage, and the same parameters are reused across ticks. Decoding happens after the recurrent thought stage has updated the dense representation.",
      "evidence": [
        {
          "kind": "section",
          "id": "sec2"
        },
        {
          "kind": "figure",
          "id": "fig-arch"
        }
      ],
