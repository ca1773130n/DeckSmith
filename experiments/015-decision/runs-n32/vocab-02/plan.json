    {
      "id": "s02-carrier",
      "intent": "The carrier equation separates dense feature creation from token-preserving window partitioning.",
      "claim": "\\mathbf{F}=\\mathcal{E}(\\mathbf{I}_{\\mathrm{LR}}),\\qquad \\mathbf{X}=\\mathcal{W}(\\mathbf{F})",
      "narration": "The encoder maps the low-resolution image into a dense feature field. That field is the persistent carrier the compact thought process can read and update. The window operator partitions the carrier into tokens without dropping them. The result is a token set made from the same dense field, ready for DQ-CTM.",
      "evidence": [
        {
          "kind": "equation",
          "id": "eq-carrier"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
