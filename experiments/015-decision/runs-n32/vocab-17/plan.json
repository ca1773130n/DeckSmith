    {
      "id": "s02-carrier",
      "intent": "The carrier equation first creates a dense feature field, then partitions it into windows without discarding tokens.",
      "claim": "\\mathbf{F}=\\mathcal{E}(\\mathbf{I}_{\\mathrm{LR}}),\\qquad \\mathbf{X}=\\mathcal{W}(\\mathbf{F})",
      "narration": "The encoder maps the low-resolution image into the feature field named F. The input to that encoder is the low-resolution image, not a sparse thought state. The window operation acts on F to produce X. Because X is defined from the full feature field, the partition keeps every token.",
      "evidence": [
        {
          "kind": "equation",
          "id": "eq-carrier"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
      "weight": 0.85,
      "seconds": 8.2,
      "objects": [
