  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the dense carrier continues through the flow.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image is first encoded into features before any compact thought process runs. The feature field is divided into windows, but the flow still moves forward toward reconstruction. The recurrence is local to the DQ-CTM ticks, so it returns to the thought stage itself. The same DQ-CTM parameters are reused across ticks before decoding produces the output.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
