    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the rest of the image pipeline stays linear.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
