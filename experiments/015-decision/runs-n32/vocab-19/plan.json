{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the thought stage, while the dense carrier continues through the pipeline.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes a dense field, so spatial detail has somewhere to live. The field is partitioned into windows before the compact thought process reads and updates it. The repeated ticks return to the thought stage itself, with parameters shared across ticks. The decoder converts the updated dense carrier back into the super-resolved image.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
