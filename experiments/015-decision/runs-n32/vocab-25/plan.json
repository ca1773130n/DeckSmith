    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage itself, while the dense carrier continues through the image pipeline.",
      "claim": "A persistent dense carrier, read and updated by a compact thought process.",
      "narration": "The image first becomes a dense carrier, so spatial detail is kept outside the compact thought state. Windows divide that carrier before the thought process reads and updates it. The recurrence is local to the thought ticks, not the full encode-to-decode path. The same DQ-CTM parameters are reused across ticks.",
      "evidence": [
        {
          "kind": "section",
          "id": "sec2"
        },
        {
