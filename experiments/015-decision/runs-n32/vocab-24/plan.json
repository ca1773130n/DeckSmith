  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the dense carrier continues forward through the pipeline.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes a dense carrier, because super-resolution needs spatial detail. Windowing organizes that carrier without making the thought state dense. The DQ-CTM stage repeats its ticks with shared parameters. The loop returns only to the thought stage, then decoding turns the updated carrier into output.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
