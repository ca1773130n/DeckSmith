  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage itself while the dense carrier continues through the pipeline.",
      "claim": "A persistent dense carrier is read and updated by a compact thought process.",
      "narration": "The image first becomes a dense carrier, then windows preserve the spatial tokens for the thought process. The DQ-CTM ticks recur inside the thought stage, using shared parameters across ticks. After the shared ticks update the carrier, the decoder turns the dense field back into the output image.",
