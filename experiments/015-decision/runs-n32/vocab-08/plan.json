    {
      "id": "s02-carrier",
      "intent": "The carrier equation separates dense feature encoding from window partitioning, and the window step preserves the tokens produced from the feature field.",
      "claim": "\\mathbf{F}=\\mathcal{E}(\\mathbf{I}_{\\mathrm{LR}}),\\qquad \\mathbf{X}=\\mathcal{W}(\\mathbf{F})",
      "narration": "The encoder maps the low-resolution image into a dense feature field called F. The window operator then partitions that field into X, the token layout used by the thought process. The equation keeps the carrier explicit, so partitioning changes organization rather than discarding tokens.",
      "evidence": [
        {
          "kind": "equation",
          "id": "eq-carrier"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
