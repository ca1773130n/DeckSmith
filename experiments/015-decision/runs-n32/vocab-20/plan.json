    {
      "id": "s02-carrier",
      "intent": "The carrier equation first creates dense features from the low-resolution image, then partitions those features into windows without discarding tokens.",
      "claim": "\\mathbf{F}=\\mathcal{E}(\\mathbf{I}_{\\mathrm{LR}}),\\qquad \\mathbf{X}=\\mathcal{W}(\\mathbf{F})",
      "narration": "The encoder maps the low-resolution image into the dense feature field named F. The input to that encoder is the low-resolution image itself. The window operator turns the dense field into X for window-wise processing. Because X comes from F, the tokens are partitioned rather than thrown away.",
      "evidence": [
        {
          "kind": "equation",
          "id": "eq-carrier"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
