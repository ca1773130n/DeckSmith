  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the dense carrier continues through the end-to-end flow.",
      "claim": "A persistent dense carrier, read and updated by a compact thought process.",
      "narration": "The image first becomes a dense carrier, because super-resolution needs spatial detail to persist. Windowing organizes that carrier without turning the whole system into a single compact state. The DQ-CTM stage reads and updates the carrier over repeated ticks. The recurrence returns to the thought stage itself, not to the encoder or decoder. The same DQ-CTM parameters are used across those ticks.",
