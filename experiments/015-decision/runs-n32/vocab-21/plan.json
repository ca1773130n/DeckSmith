  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-method-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage itself, while the dense carrier continues through the full super-resolution flow.",
      "claim": "A persistent dense carrier, read and updated by a compact thought process.",
      "narration": "The encoder first makes a dense carrier from the low-resolution image. The carrier is partitioned into windows before the thought process reads it. The shared DQ-CTM stage ticks recurrently on itself, not around the full pipeline. The decoder receives the updated dense field and produces the high-resolution result. The same DQ-CTM parameters are reused across ticks.",
      "evidence": [
        {
          "kind": "section",
          "id": "sec2"
        },
        {
          "kind": "figure",
          "id": "fig-arch"
        }
      ],
