{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The recurrence returns to the DQ-CTM thought stage, while the full image still moves through encode, window, thought, and decode once.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The low-resolution image is first encoded into features before any thought tick runs. The window step prepares the carrier for local processing without sending the whole image around the loop. The repeated part is only the DQ-CTM thought process, not the entire pipeline. The same DQ-CTM parameters are reused across ticks. The decoder receives the updated dense carrier after the shared thought process finishes.",
