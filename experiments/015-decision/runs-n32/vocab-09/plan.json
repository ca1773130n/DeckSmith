{
  "sourceId": "thinksr",
  "title": "ThinkSR: compact thought, dense output",
  "lang": "en",
  "scenes": [
    {
      "id": "s01-flow",
      "intent": "The image moves through four stages, while recurrence returns only to the DQ-CTM thought stage and reuses parameters across ticks.",
      "claim": "ThinkSR end to end: encoder, windows, shared DQ-CTM ticks, decoder.",
      "narration": "The image first becomes a dense carrier, so spatial detail has a place to live. Windowing organizes that carrier without ending the dense representation. The DQ-CTM block is the recurrent part, and its loop returns to the thought stage itself. The repeated ticks share parameters, so recurrence does not wrap the whole pipeline.",
      "evidence": [
        {
          "kind": "figure",
          "id": "fig-arch"
        },
        {
          "kind": "section",
          "id": "sec2"
        }
      ],
